[alias]
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	nc = commit -a --allow-empty-message -m ""

[commit]
	gpgsign = true

[color]
	ui = true

[core]
	excludesfile = ~/.gitignore
	# core.editor is deliberately unset so git falls through to VISUAL/EDITOR.
	# Those already resolve to `code --wait`, and on a headless Linux box they
	# resolve to nvim instead (see env/linux.zsh) — hardcoding code here would
	# override that and break `git commit` over ssh.

[diff]
  tool = code

[difftool "code"]
  cmd = code --wait --diff $LOCAL $REMOTE

[fetch]
	prune = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[gpg]
	format = ssh

[init]
	defaultBranch = main

[pull]
	ff = only

[user]
	name = Kelly Mears
	email = developers@tinypixel.dev
	signingkey = /home/kelly/.ssh/id_ed25519.pub
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[tag]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = /home/kelly/.config/git/allowed_signers
