# macOS entry point. Linked to ~/Library/Application Support/com.mitchellh.ghostty/
# by setup/link.zsh, because Ghostty ignores XDG_CONFIG_HOME when launched
# from the Dock.
#
# Linux uses linux.conf instead; anything belonging to both goes in shared.conf.

config-file                 = shared.conf

background-opacity          = 1

# Global show/hide. macOS-only: it needs the system-wide hotkey API, and on
# Linux the compositor owns global bindings (bind it in Hyprland instead).
keybind                     = global:option+space=toggle_visibility

macos-non-native-fullscreen = true
# macos-titlebar-style      = hidden

# Wide-gamut on Apple displays. Ignored elsewhere.
window-colorspace           = display-p3

theme                       = Snazzy

# VT520 phosphor filter — disabled, shader kept in shaders/ for later.
#
# Ghostty loads this config twice on macOS when launched from a shell:
# once via the Application Support symlink and once via XDG_CONFIG_HOME,
# which env/darwin.zsh points at this repo. Scalar options are harmless
# (last wins) but custom-shader is repeatable, so the filter stacked on
# itself in shell-launched windows and not in Dock-launched ones.
#
# The `shaders` directory is still symlinked alongside this file, for the
# relative-path reason described in shared.conf.
# custom-shader             = shaders/vt520.glsl
# custom-shader-animation   = true
