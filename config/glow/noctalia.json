{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c0caf5",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#9aa5ce"
  },
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#7aa2f7",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#16161e",
    "background_color": "#7aa2f7",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "#87abf8",
    "bold": false
  },
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#5d6682",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#bb9af7",
    "underline": true
  },
  "link_text": {
    "color": "#7aa2f7",
    "bold": true
  },
  "image": {
    "color": "#9ece6a",
    "underline": true
  },
  "image_text": {
    "color": "#5d6682"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#9ece6a",
    "background_color": "#0f1325"
  },
  "code_block": {
    "color": "#c0caf5",
    "margin": 2,
    "chroma": {
      "text": { "color": "#c0caf5" },
      "error": {
        "color": "#16161e",
        "background_color": "#f7768e"
      },
      "comment": { "color": "#5d6682" },
      "keyword": { "color": "#7aa2f7" },
      "keyword_reserved": { "color": "#9ece6a" },
      "keyword_type": { "color": "#bb9af7" },
      "operator": { "color": "#9ece6a" },
      "punctuation": { "color": "#9aa5ce" },
      "name": { "color": "#c0caf5" },
      "name_builtin": { "color": "#87abf8" },
      "name_function": { "color": "#7aa2f7" },
      "literal_number": { "color": "#af89f6" },
      "literal_string": { "color": "#bb9af7" },
      "generic_deleted": { "color": "#f7768e" },
      "generic_inserted": { "color": "#af89f6" },
      "background": { "background_color": "#000000" }
    }
  },
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
